# Get a key from https://aistudio.google.com/apikey
# Copy this file to backend/.env (that file is gitignored).
# `neon env pull` from the linked project also writes DATABASE_URL and AWS_*.
GEMINI_API_KEY=paste_your_key_here
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=tcg-media
